# Copy to .env and fill in GEMINI_API_KEY. Every other value has a working default.
# Never commit .env.

# --- Gemini (https://aistudio.google.com/apikey) -------------------------------------------
GEMINI_API_KEY=
# Set both providers to "fake" to run the whole stack offline without a key
# (answers are then the best-matching passage, not model-written).
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# --- Auth ------------------------------------------------------------------------------------
# Required when APP_ENV=production: a random string of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it unset for local development (a fixed development secret is used).
# JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# --- App ---------------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Used when running the API or tests outside Docker (compose sets its own URL for containers).
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5433/documind

# --- Local ports and database credentials used by docker compose -----------------------------
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000

# --- Limits (defaults shown) -------------------------------------------------------------------
# MAX_UPLOAD_MB=10
# MAX_DOCUMENTS_PER_USER=20
# QUESTIONS_PER_MINUTE=10
# QUESTIONS_PER_DAY=100
# GLOBAL_QUESTIONS_PER_DAY=200
# AUTH_ATTEMPTS_PER_MINUTE=10
# UPLOADS_PER_DAY=20
# GLOBAL_UPLOADS_PER_DAY=200

# --- Retrieval (defaults shown) ----------------------------------------------------------------
# RETRIEVAL_TOP_K=6
# RETRIEVAL_MIN_SIMILARITY=0.35
# CHUNK_SIZE_CHARS=1400
# CHUNK_OVERLAP_CHARS=200

# --- Client IP for rate limits ----------------------------------------------------------------
# true behind a reverse proxy such as Render's (the IP is read from X-Forwarded-For), false when
# clients connect directly. Required when APP_ENV=production; not trusted if left unset.
# TRUST_PROXY_HEADERS=false
