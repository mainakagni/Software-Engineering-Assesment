DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/documind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documind


REDIS_URL=redis://redis:6379/0


JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-random-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE=https://api.groq.com/openai/v1


EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=768


RATE_LIMIT_QUESTIONS_PER_MINUTE=20
MAX_UPLOAD_FILE_SIZE_MB=25


LOG_LEVEL=INFO
ENVIRONMENT=development
