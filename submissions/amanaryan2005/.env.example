# ─────────────────────────────────────────────────────────────────────────────
# DocuMind — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-secure-random-string-of-at-least-32-chars
LOG_LEVEL=INFO
DEBUG=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://documind:changeme@postgres:5432/documind
# For pooled connections (e.g., Neon), uncomment and set:
# DATABASE_URL_POOLED=postgresql://user:password@host/dbname?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Google Gemini (required!) ─────────────────────────────────────────────────
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=/tmp/documind_uploads

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_QUESTIONS_PER_MINUTE=10

# ── RAG Parameters ───────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_CHUNKS=5

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
