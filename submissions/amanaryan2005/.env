# ─────────────────────────────────────────────────────────────────────────────
# DocuMind — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-secure-random-string-of-at-least-32-chars
LOG_LEVEL=INFO
DEBUG=false


# ── PostgreSQL / Neon ────────────────────────────────────────────────────────
# Neon PostgreSQL is being used instead of a local/Docker PostgreSQL server.

DATABASE_URL=postgresql://neondb_owner:npg_pfGgi17PJLDh@ep-damp-feather-b4r2q615-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: keep these only if your application config expects them.
POSTGRES_HOST=ep-damp-feather-b4r2q615-pooler.c-6.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=npg_pfGgi17PJLDh


# ── Redis ─────────────────────────────────────────────────────────────────────
# These are Docker Redis URLs. Change them if Redis is not running in Docker.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1


# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=enter your api keys;
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash


# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=/tmp/documind_uploads


# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_QUESTIONS_PER_MINUTE=10


# ── RAG Parameters ───────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_CHUNKS=5


# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
